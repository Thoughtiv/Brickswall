# Port for the express server to run on
PORT=5000

# Database credentials
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# Admin configuration
ADMIN_PASSWORD=your_admin_password_here

# Groq AI API Key (get from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Allowed frontend origins for CORS (comma-separated, no trailing slashes)
# Local dev:
# FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
# Production:
FRONTEND_URL=https://brickswall.in,https://www.brickswall.in
